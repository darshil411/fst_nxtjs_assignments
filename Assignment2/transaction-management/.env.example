# ------------------------------------------------------------------
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/txnmgmt?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL of the app (used in emails and by the auth client)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="TxnManager <onboarding@resend.dev>"

# Resend webhook signing secret — https://resend.com/webhooks
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Password assigned to every seeded demo user (development only)
SEED_USER_PASSWORD="ChangeMe123!"
